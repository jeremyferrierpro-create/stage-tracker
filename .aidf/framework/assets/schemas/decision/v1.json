{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidf.dev/schemas/decision/v1",
  "$defs": {
    "source": {
      "type": "object",
      "required": ["type", "author", "createdAt"],
      "properties": {
        "type": { "enum": ["human", "generated", "derived"] },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "generator": { "type": ["string", "null"] }
      }
    },
    "linkage": {
      "type": "object",
      "properties": {
        "implements": { "type": "array", "items": { "type": "string" } },
        "designedBy": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": {
      "type": "object",
      "required": ["schemaVersion", "timestamp", "valid"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "adr": {
      "type": "object",
      "required": ["id", "title", "status", "date", "context", "options", "decision", "consequences"],
      "properties": {
        "id": { "type": "string", "pattern": "^ADR-\\d{3}$" },
        "title": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "superseded", "rejected", "BLOCKED"]
        },
        "date": { "type": "string", "format": "date-time" },
        "deciders": {
          "type": "array",
          "items": { "type": "object" }
        },
        "related": {
          "type": "array",
          "items": { "type": "string" }
        },
        "context": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "pros", "cons"],
            "properties": {
              "name": { "type": "string" },
              "pros": { "type": "string" },
              "cons": { "type": "string" }
            }
          }
        },
        "decision": { "type": "string" },
        "consequences": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "type": "object",
  "required": ["id", "schemaVersion", "createdAt", "updatedAt", "status", "source", "links", "validation"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DECISIONS-\\d{3}$",
      "description": "Decision log identifier"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Schema version"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "BLOCKED", "OUTDATED"]
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/adr" }
    },
    "source": { "$ref": "#/$defs/source" },
    "links": { "$ref": "#/$defs/linkage" },
    "validation": { "$ref": "#/$defs/validation" }
  }
}