{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidf.dev/schemas/discovery/v1",
  "$defs": {
    "source": {
      "type": "object",
      "required": ["type", "author", "createdAt"],
      "properties": {
        "type": { "enum": ["human", "generated", "derived"] },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "generator": { "type": ["string", "null"] }
      }
    },
    "linkage": {
      "type": "object",
      "properties": {
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": {
      "type": "object",
      "required": ["schemaVersion", "timestamp", "valid"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fact": {
      "type": "object",
      "required": ["id", "category", "description", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["stack", "structure", "constraints", "resources", "risks", "open_questions"]
        },
        "description": { "type": "string", "minLength": 5 },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "File references, command outputs, or evidence IDs"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Based on evidence quality"
        },
        "assumption": {
          "type": "boolean",
          "description": "Is this a declared assumption?"
        }
      }
    }
  },
  "type": "object",
  "required": ["id", "schemaVersion", "createdAt", "updatedAt", "status", "source", "links", "validation"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DISC-\\d{3}$",
      "description": "Discovery report identifier"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Schema version"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "BLOCKED", "OUTDATED"]
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact" }
    },
    "source": { "$ref": "#/$defs/source" },
    "links": { "$ref": "#/$defs/linkage" },
    "validation": { "$ref": "#/$defs/validation" }
  }
}