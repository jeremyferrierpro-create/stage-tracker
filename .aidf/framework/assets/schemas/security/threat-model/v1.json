{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidf.dev/schemas/security/threat-model/v1",
  "$defs": {
    "source": {
      "type": "object",
      "required": ["type", "author", "createdAt"],
      "properties": {
        "type": { "enum": ["human", "generated", "derived"] },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "generator": { "type": ["string", "null"] }
      }
    },
    "linkage": {
      "type": "object",
      "properties": {
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": {
      "type": "object",
      "required": ["schemaVersion", "timestamp", "valid"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "name", "classification", "owner", "storage"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "owner": { "type": "string" },
        "storage": { "type": "string" },
        "retention": { "type": "string" }
      }
    },
    "threat": {
      "type": "object",
      "required": ["id", "name", "stride", "asset", "mitigation"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "stride": {
          "type": "string",
          "enum": ["Spoofing", "Tampering", "Repudiation", "Information Disclosure", "Denial of Service", "Elevation of Privilege"]
        },
        "asset": { "type": "string" },
        "likelihood": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "impact": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "mitigation": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["open", "mitigated", "accepted", "rejected"]
        }
      }
    },
    "trustBoundary": {
      "type": "object",
      "required": ["id", "name", "components"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "type": "object",
  "required": ["id", "schemaVersion", "createdAt", "updatedAt", "status", "source", "links", "validation"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TM-\\d{3}$",
      "description": "Threat model identifier"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Schema version"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "BLOCKED", "OUTDATED"]
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "threats": {
      "type": "array",
      "items": { "$ref": "#/$defs/threat" }
    },
    "trustBoundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/trustBoundary" }
    },
    "source": { "$ref": "#/$defs/source" },
    "links": { "$ref": "#/$defs/linkage" },
    "validation": { "$ref": "#/$defs/validation" }
  }
}