{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidf.dev/schemas/requirement/v1",
  "$defs": {
    "source": {
      "type": "object",
      "required": ["type", "author", "createdAt"],
      "properties": {
        "type": { "enum": ["human", "generated", "derived"] },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "generator": { "type": ["string", "null"] }
      }
    },
    "link": {
      "type": "object",
      "required": ["targetId", "targetType", "type"],
      "properties": {
        "targetId": { "type": "string" },
        "targetType": {
          "type": "string",
          "enum": ["requirement", "decision", "design", "implementation", "test", "evidence"]
        },
        "type": {
          "type": "string",
          "enum": ["implements", "designed-by", "implemented-by", "verified-by", "evidenced-by"]
        }
      }
    },
    "linkage": {
      "type": "object",
      "properties": {
        "implements": { "type": "array", "items": { "type": "string" } },
        "designedBy": { "type": "array", "items": { "type": "string" } },
        "implementedBy": { "type": "array", "items": { "type": "string" } },
        "verifiedBy": { "type": "array", "items": { "type": "string" } }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "verification": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["test", "manual", "review"] },
            "testPath": { "type": "string" },
            "command": { "type": "string" }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["schemaVersion", "timestamp", "valid"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "status",
    "type",
    "title",
    "description",
    "source",
    "links",
    "validation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-(F|NF)-\\d{3}$",
      "description": "Stable identifier (REQ-F-XXX for functional, REQ-NF-XXX for non-functional)"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Schema version (independent of AIDF version)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Immutable creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Mutable last update timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "BLOCKED", "OUTDATED"],
      "description": "Requirement status"
    },
    "type": {
      "type": "string",
      "enum": ["FUNCTIONAL", "NON_FUNCTIONAL"],
      "description": "Requirement type"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Brief requirement title"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Detailed requirement description"
    },
    "priority": {
      "type": "string",
      "enum": ["must", "should", "could"],
      "description": "Priority level"
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterion" },
      "description": "Acceptance criteria with verification methods"
    },
    "source": { "$ref": "#/$defs/source" },
    "links": { "$ref": "#/$defs/linkage" },
    "validation": { "$ref": "#/$defs/validation" }
  }
}