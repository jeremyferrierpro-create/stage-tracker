# Dépendances et artefacts reconstruits dans l'image
/vendor
/node_modules
/public/build
/public/hot

# VCS et IDE
.git
.gitignore
.gitattributes
.idea
.vscode

# Environnement local et secrets — jamais dans l'image
.env
.env.*
!.env.example

# Tests et outillage non nécessaires au runtime
/tests
/phpunit.xml
/.aidf
/.qoder
/.opencode

# Logs et fichiers générés
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php

# Assets sources (compilés par npm run build dans l'image)
# resources/ est nécessaire : Vite compile depuis les sources.
